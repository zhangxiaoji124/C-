# Server
ORBITOPS_HOST=127.0.0.1
ORBITOPS_PORT=8080
ORBITOPS_DB=data/orbitops.db
ORBITOPS_WEB=web

# Local Ollama provider
ORBITOPS_OLLAMA_ENABLED=true
ORBITOPS_OLLAMA_URL=http://127.0.0.1:11434
ORBITOPS_OLLAMA_MODEL=llama3.2:3b
ORBITOPS_OLLAMA_REVIEW_MODEL=llama3.2:3b
ORBITOPS_OLLAMA_TIMEOUT=360
ORBITOPS_OLLAMA_FALLBACK=true

# Autonomous development workspace (all generated files stay inside this directory)
ORBITOPS_DEV_WORKSPACE=agent_workspace
